# Токен Telegram-бота (required для локального запуска)
BOT_TOKEN = "your_telegram_bot_token"
# Optional Telegram HTTP/SOCKS proxy, for example local Hiddify mixed proxy:
# TELEGRAM_PROXY_URL = "http://127.0.0.1:12334"
# Токен Т-Инвестиций для боевого счета (prod-only; оставьте пустым для sandbox v1)
TOKEN = ""
# Токен песочницы Т-Инвестиций (required для sandbox v1)
SANDBOX_TOKEN = "your_sandbox_token"
# ID чата Telegram (required)
CHAT_ID = "your_telegram_chat_id"
# Комиссия брокера (required)
BROKER_FEE = 0.3
# Optional MOEX index source for Telegram charts. No broker orders are created from chart data.
MOEX_MARKET_CONTEXT_INDEXES = "IMOEX,RTSI"
# Single local user config. Copy users.example.json to users.json for the owner.
USERS_CONFIG_PATH = "users.json"
# Optional default user for local token/fee helpers when users.json has several users.
DEFAULT_USER_ID = "default"
# Режим приложения: sandbox или prod. По умолчанию sandbox.
APP_MODE = "sandbox"
# Legacy alias для старого кода; оставьте sandbox для v1.
INVEST_MODE = "sandbox"
# Защита от случайной торговли на боевом счете. Для prod нужны APP_MODE="prod", TOKEN и ALLOW_PROD_TRADING="true".
ALLOW_PROD_TRADING = "false"
# Фоновые планировщики уведомлений/планов отключены по умолчанию.
ENABLE_BACKGROUND_SCHEDULERS = "false"
# Read-only refresh локального кэша свечей для web charts. Обновляет только watchlist/portfolio tickers.
ENABLE_CHART_DATA_REFRESH = "false"
CHART_DATA_REFRESH_SECONDS = "60"
CHART_DATA_REFRESH_RANGES = "day,month"
# Простые ежедневные напоминания инвестора без сигналов и автоторговли.
ENABLE_INVESTOR_REMINDERS = "false"
INVESTOR_REMINDER_TIME = "09:00"
# Инвестиционные планы. При включении scheduler может отправлять Telegram-подтверждения,
# но брокерская заявка требует явного подтверждения.
ENABLE_INVESTMENT_PLANS = "false"
# Anti-greedy policy: ежедневно ищет позиции с профитом выше порога и отправляет
# Telegram-подтверждение на продажу. Брокерская заявка не исполняется без подтверждения.
ENABLE_ANTI_GREEDY_POLICY = "false"
ANTI_GREEDY_PROFIT_PCT = "20"
ANTI_GREEDY_CHECK_TIME = "18:30"
# Локальные strategy proposals. При включении вместе с ENABLE_BACKGROUND_SCHEDULERS
# scheduler может отправлять Telegram-подтверждения, но не исполняет заявки сам.
ENABLE_STRATEGY_PROPOSALS = "false"
STRATEGY_CONFIRMATION_REQUIRED_DIR = "user_strategies/confirmation_required"
# Deprecated alias for STRATEGY_CONFIRMATION_REQUIRED_DIR; keep only for old local setups.
STRATEGY_PROPOSALS_DIR = ""
# No-confirmation strategy observations: only history/check records and optional Telegram notification.
ENABLE_STRATEGY_OBSERVATIONS = "false"
STRATEGY_NO_CONFIRMATION_DIR = "user_strategies/observations"
ENABLE_STRATEGY_OBSERVATION_TELEGRAM_NOTIFICATIONS = "false"
STRATEGY_PROPOSAL_CHECK_INTERVAL_SECONDS = "60"
# Strategy auto-execution: disabled by default, always sandbox-only, and constrained by limits.
ENABLE_STRATEGY_AUTO_EXECUTION = "false"
ALLOW_STRATEGY_AUTO_EXECUTION = "false"
# Compatibility/display flag only; production strategy auto-execution remains blocked even if false.
STRATEGY_AUTO_EXECUTION_SANDBOX_ONLY = "true"
STRATEGY_AUTO_EXECUTION_DIR = "user_strategies/auto_execute"
STRATEGY_AUTO_EXECUTION_CHECK_INTERVAL_SECONDS = "60"
STRATEGY_AUTO_DEDUPE_WINDOW_SECONDS = "86400"
MAX_STRATEGY_AUTO_ORDER_RUB = "0"
MAX_DAILY_STRATEGY_AUTO_RUB = "0"
# Автоинвестирование. Даже при true ограничено политиками, лимитами и режимом приложения.
ALLOW_AUTO_INVESTING = "false"
# Жесткий лимит на одну автоматическую заявку в рублях. Значение 0 блокирует автоисполнение.
MAX_ORDER_RUB = "0"
# Жесткий дневной лимит на автоматическое инвестирование в рублях. Значение 0 блокирует автоисполнение.
MAX_DAILY_INVEST_RUB = "0"
